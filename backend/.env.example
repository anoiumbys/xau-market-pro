APP_NAME="XAU Market Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (Docker service: db)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=xau_market_pro
DB_USERNAME=xaupro
DB_PASSWORD=xaupro_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting (Docker service: websockets)
BROADCAST_DRIVER=websockets
BROADCAST_CONNECTION=websockets

WEBSOCKETS_HOST=websockets
WEBSOCKETS_PORT=6001
WEBSOCKETS_KEY=local
WEBSOCKETS_SECRET=secret
WEBSOCKETS_SSL=false

# Cache (Docker service: redis)
CACHE_STORE=redis
CACHE_PREFIX=xau_market_

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Queue (Docker service: redis)
QUEUE_CONNECTION=redis

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@xaupro.test"
MAIL_FROM_NAME="${APP_NAME}"

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@xaupro.test

SANCTUM_STATEFUL_DOMAINS=localhost:8000,localhost:3000,127.0.0.1:8000,127.0.0.1:3000
SESSION_DOMAIN=localhost

PULSE_ENABLED=false
TELESCOPE_ENABLED=false